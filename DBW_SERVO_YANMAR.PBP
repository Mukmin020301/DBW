'****************************************************************
'*  Name    : DBW_SERVO_YANMAR.PBP                              *
'*  Author  : Focus Applied Technologies / Horizon (c) 2026      *
'*  Target  : Fuel Stretcher V2.0 (PIC18F46K22 @ 16MHz)         *
'*  Purpose : Full 0-180 Deg RC Servo Throttle for Yanmar L48   *
'*  Output  : Inj01 (PORTD.1) Only - Zero Serial Overhead       *
'*  Range   : 500us (0 Deg / Idle) to 2500us (180 Deg / WOT)    *
'****************************************************************

'OSCILLATOR & COMPILER CONFIG===================================
osccon = %01110111              'HFINTOSC 16MHz
define OSC 16
define ADC_BITS 8               '8-bit ADC (0-255 for 0-5V)
define ADC_CLOCK 3              'Internal RC
define ADC_SAMPLEUS 50

'I/O CONFIGURATION===============================================
ANSELA = %00000000              'All digital
ANSELB = %00000000
ANSELC = %00000000
ANSELD = %00010000              'PORTD.4 (AN24) Analog TPS In
ANSELE = %00000000

TRISA  = %11111111              'Inputs
TRISB  = %11111111
TRISC  = %11111111              'All digital inputs
TRISD  = %11111001              'PORTD.1 (Inj01) Output, PORTD.2 (LED1) Output
TRISE  = %00000111

'Initialize all port outputs to 0
porta = 0 : portb = 0 : portc = 0 : portd = 0 : porte = 0

'PIN & VARIABLE DEFINITIONS======================================
ServoPin    var PORTD.1         'Inj01 pin to MG995R Signal
LED1        var PORTD.2         'Heartbeat LED

tps         var word            'Raw ADC reading (0-255)
tpsav       var word            'Filtered TPS
tpsold      var word            'Previous TPS for deadband check
th          var word            'Servo Time High (200=500us, 1000=2500us)
span        var word            'Calibration span (Phi - Plo = 800)
Plo         var word            'Idle pulse width (200 = 500us / 0 Deg)
Phi         var word            'WOT pulse width (1000 = 2500us / 180 Deg)
diff        var word            'Absolute difference for deadband
i           var byte            'Counter for startup blink

'EEPROM CALIBRATION DEFAULTS====================================
'Plo = 200 (500us / 0.5ms Idle), Phi = 1000 (2500us / 2.5ms WOT)
'200 = $00C8 (0, 200), 1000 = $03E8 (3, 232)
data 0,200, 3,232

'INITIALIZATION==================================================
clear
ServoPin = 0                    'Ensure servo signal starts at LOW (0V)

read 0, Plo.byte1 : read 1, Plo.byte0
read 2, Phi.byte1 : read 3, Phi.byte0

'Sanity check EEPROM limits for MG995 0-180 degree stroke
if (Plo < 150) or (Plo > 400) then Plo = 200
if (Phi < 700) or (Phi > 1100) then Phi = 1000
if Plo >= Phi then Plo = 200 : Phi = 1000

span = Phi - Plo                '800 counts = 2000us span
th = Plo

'Power-up startup LED blink
for i = 1 to 3
    LED1 = 1 : pause 100
    LED1 = 0 : pause 100
next i

'Read initial TPS
adcin 24, tps
tpsav = tps
tpsold = tps

'MAIN CONTROL LOOP (PURE 50Hz RC PWM)============================
Main:
    '1. Read 0-5V TPS Potentiometer (AN24 / PORTD.4)
    adcin 24, tps

    '2. Deadband Filter (Eliminates ADC noise & servo tremble)
    if tps >= tpsold then
        diff = tps - tpsold
    else
        diff = tpsold - tps
    endif

    if diff > 1 then
        tpsav = (3 * tpsav + tps) / 4
        tpsold = tps
    endif

    '3. Scaled pulse calculation (Overflow-safe 16-bit math)
    '   span = 800 -> span / 5 = 160
    '   Max intermediate product: 160 * 255 = 40,800 (< 65,535)
    '   At tpsav = 0   -> th = Plo = 200 (500us / 0 Deg)
    '   At tpsav = 255 -> th = Plo + 800 = 1000 (2500us / 180 Deg)
    th = Plo + ((span / 5) * tpsav) / 51

    '4. Constrain within calibrated limits
    if th < Plo then th = Plo
    if th > Phi then th = Phi

    '5. Generate Active-HIGH 50Hz RC pulse on Inj01 (PORTD.1) ONLY
    '   Each count = 2.5us at 16MHz (200 = 500us, 1000 = 2500us)
    pulsout ServoPin, th

    '6. Heartbeat LED proportional to throttle activity
    if tpsav > 25 then
        LED1 = 1
    else
        LED1 = 0
    endif

    '7. Frame timing: 18ms pause maintains precise ~50Hz (20ms) frame
    pause 18

goto Main
